{
  "name": "HTML (ERB)",
  "scopeName": "text.html.erb",
  "patterns": [
    {"include": "#erb"},
    {"include": "text.html.basic"}
  ],
  "injections": {
    "L:text.html.erb - (meta.embedded.erb | comment.block.erb)": {
      "patterns": [{"include": "#erb"}]
    }
  },
  "repository": {
    "erb": {
      "patterns": [
        {"include": "#comment-tag"},
        {"include": "#ruby-tag"}
      ]
    },
    "comment-tag": {
      "name": "comment.block.erb",
      "begin": "<%#",
      "end": "-?%>",
      "beginCaptures": {
        "0": {"name": "punctuation.definition.comment.begin.erb"}
      },
      "endCaptures": {
        "0": {"name": "punctuation.definition.comment.end.erb"}
      }
    },
    "ruby-tag": {
      "name": "meta.embedded.erb",
      "contentName": "source.ruby.embedded.erb",
      "patterns": [{"include": "source.ruby"}],
      "begin": "<%(?:=|-)?",
      "end": "-?%>",
      "beginCaptures": {
        "0": {"name": "punctuation.section.embedded.begin.erb"}
      },
      "endCaptures": {
        "0": {"name": "punctuation.section.embedded.end.erb"}
      }
    }
  }
}
